<table class="table table-bordered">
  <tbody>
    <tr>
      <th scope="row">Email</th>
      <td><%= @user.email %></td>
    </tr>
    <tr>
      <th scope="row">Name</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th scope="row">Avatar</th>
      <td>
        <%= image_tag(@user.avatar.url, class: 'rounded-circle', size: '100x100') %>
      </td>
    </tr>
  </tbody>
</table>
