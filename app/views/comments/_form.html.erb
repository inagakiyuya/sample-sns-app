<div class="row mb-3">
  <div class="col-lg-8 offset-lg-2">
    <%= form_with model: comment, url: [post, comment], local: true do |f| %>
      <%= render 'shared/error_messages', object: f.object %>
      <%= f.label :comment_content %>
      <%= f.text_area :comment_content, class: 'form-control mb-3', id: 'js-new-comment-body', rows: 4, placeholder: 'テキスト' %>
      <%= f.submit 'コメントを作成', class: 'btn btn-primary' %>
    <% end %>
  </div>
</div>
