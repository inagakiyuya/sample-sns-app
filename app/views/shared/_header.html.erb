<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Sample-SNS-App</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <form class="d-flex">
        <%= search_form_for @q do |f| %>
        <%= f.search_field :title_or_post_content_cont, class: "form-control me-2", id: "search_field_of_post", placeholder: "投稿"%>
        <%= f.search_field :user_name_cont, class: "form-control me-2", id: "search_field_of_user", placeholder: "ユーザー"%>

        <%= f.submit "Search", class: "btn btn-outline-success" %>
        <% end %>
      </form>
      <ul class="navbar-nav mb-2 mb-lg-0 ms-auto">
          <li class="list-inline-item">
            <%= link_to posts_path, class: 'nav-link' do %>
              <i class="bi bi-journal-text"></i>
              投稿一覧
            <% end %>
          </li>
        <% if current_user.present? %>
          <li class="list-inline-item">
            <%= link_to new_post_path, class: 'nav-link' do %>
              <i class="bi bi-plus-square"></i>
              投稿作成
            <% end %>
          </li>
          <li class="list-inline-item">
            <%= link_to '#', class: 'nav-link' do %>
              <i class="bi bi-file-earmark-person"></i>
              マイ投稿一覧
            <% end %>
          </li>
          <li class="list-inline-item">
            <%= link_to '#', class: 'nav-link' do %>
              <i class="bi bi-file-check-fill"></i>
              お気に入り投稿一覧
            <% end %>
          </li>
          <li class="list-inline-item">
            <%= link_to edit_profile_path, class: 'nav-link' do %>
              <i class="bi bi-person-circle"></i>
              マイページ
            <% end %>
          </li>
        <% else %>
          <li class="list-inline-item">
            <%= link_to sign_up_path, class: 'nav-link' do %>
              <i class="bi bi-database-add"></i>
              ユーザー登録
            <% end %>
          </li>
          <li class="list-inline-item">
            <%= link_to login_path, class: 'nav-link' do %>
              <i class="bi bi-arrow-up-square"></i>
              ログイン
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
