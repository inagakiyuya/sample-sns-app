<div class="post-form">
  <%= form_with model: post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :"タイトル" %>
      <%= f.text_area :title, class: 'form-control', rows: 1 %>
    </div>
    <div class="form-group">
      <%= f.label :"内容" %>
      <%= f.text_area :post_content, class: 'form-control', rows: 3 %>
    </div>
    <%= f.submit "投稿する" %>
  <% end %>
</div>